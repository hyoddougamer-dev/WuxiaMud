{
  "name": "ninefold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ninefold \u2014 an idle cultivation game where a path is a schedule, not a power level.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "measure": "node --experimental-strip-types tools/contentLength.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  }
}
